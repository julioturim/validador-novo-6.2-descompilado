<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>br.gov.mpf.pgr.asspa</groupId>
	<artifactId>simba-validador</artifactId>
	<version>6.2.6</version>
	<name>Validador SIMBA</name>
	<description>Validador SIMBA</description>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.14</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<java.version>25</java.version>
		<build.dir>${basedir}/target/build</build.dir>
		<sysName>SIMBA</sysName>
		<programFolder>Programas SIMBA</programFolder>
		<startMenuFolder>Programas SIMBA</startMenuFolder>
		<appName>Validador</appName>
		<mainClass>br.mp.mpf.spea.simba.validador.Main</mainClass>
	</properties>
	<dependencies>
		<dependency>
			<groupId>br.mp.mpf.pgr</groupId>
			<artifactId>spea-client</artifactId>
			<version>2.4.4</version>
			<scope>system</scope>
			<systemPath>C:\Users\Julio\.m2\repository\br\mp\mpf\pgr\spea-client\2.4.4\spea-client-2.4.4.jar</systemPath>
		</dependency>

		<!-- Springframework -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-context</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.hsqldb</groupId>
			<artifactId>hsqldb</artifactId>
		</dependency>

		<!-- Zip4J -->
		<dependency>
			<groupId>net.lingala.zip4j</groupId>
			<artifactId>zip4j</artifactId>
			<version>2.6.1</version>
		</dependency>

		<!-- Guava -->
		<dependency>
			<groupId>com.google.guava</groupId>
			<artifactId>guava</artifactId>
			<version>33.4.8-jre</version>
		</dependency>
		
		<dependency>
			<groupId>org.apache.velocity</groupId>
			<artifactId>velocity-engine-core</artifactId>
			<version>2.4.1</version>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<skipTests>true</skipTests>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<addClasspath>true</addClasspath>
							<classpathPrefix>lib/</classpathPrefix>
							<mainClass>${mainClass}</mainClass>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<executions>
					<execution>
						<id>create exe</id>
						<phase>package</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<property name="compile_classpath" refid="maven.compile.classpath" />
								<property name="runtime_classpath" refid="maven.runtime.classpath" />

								<ant antfile="${basedir}/build.xml">
									<target name="default" />
								</ant>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<!-- Profile: mvn package -Pjlink -->
		<profile>
			<id>jlink</id>
			<properties>
				<jlink.script>${basedir}/scripts/jlink-build.cmd</jlink.script>
				<verify.script>${basedir}/scripts/verify-tools.cmd</verify.script>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-dependency-plugin</artifactId>
						<executions>
							<execution>
								<id>copy-dependencies</id>
								<phase>prepare-package</phase>
								<goals>
									<goal>copy-dependencies</goal>
								</goals>
								<configuration>
									<outputDirectory>${build.dir}/lib</outputDirectory>
									<overWriteReleases>false</overWriteReleases>
									<overWriteSnapshots>true</overWriteSnapshots>
									<overWriteIfNewer>true</overWriteIfNewer>
									<includeScope>runtime</includeScope>
								</configuration>
							</execution>
						</executions>
					</plugin>

					<!-- 0. Verify required tools are available -->
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.5.0</version>
						<executions>
							<execution>
								<id>verify-tools</id>
								<phase>validate</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>${verify.script}</executable>
								</configuration>
							</execution>

							<!-- 1a. jdeps: analyze module dependencies -->
							<execution>
								<id>jdeps-analyze</id>
								<phase>package</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>jdeps</executable>
									<arguments>
										<argument>--ignore-missing-deps</argument>
										<argument>--print-module-deps</argument>
										<argument>--multi-release</argument>
										<argument>${java.version}</argument>
										<argument>--class-path</argument>
										<argument>${build.dir}/lib/*</argument>
										<argument>${project.build.directory}/${project.artifactId}-${project.version}.jar</argument>
									</arguments>
									<outputFile>${project.build.directory}/jdeps-modules.txt</outputFile>
								</configuration>
							</execution>

							<!-- 1b. jlink: create custom runtime at target/build/jre -->
							<execution>
								<id>jlink-runtime</id>
								<phase>package</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>${jlink.script}</executable>
									<arguments>
										<argument>${project.build.directory}/jdeps-modules.txt</argument>
										<argument>${build.dir}/jre</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>

					<!-- 2. Run launch4j + inno setup via antrun (reuses build.xml) -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<executions>
							<execution>
								<id>create-installer</id>
								<phase>package</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<property name="compile_classpath" refid="maven.compile.classpath" />
										<property name="runtime_classpath" refid="maven.runtime.classpath" />

										<ant antfile="${basedir}/build.xml">
											<target name="default" />
										</ant>
									</target>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- OS-specific profiles to select the correct scripts -->
		<profile>
			<id>jlink-windows</id>
			<activation>
				<os>
					<family>windows</family>
				</os>
			</activation>
			<properties>
				<jlink.script>${basedir}/scripts/jlink-build.cmd</jlink.script>
				<verify.script>${basedir}/scripts/verify-tools.cmd</verify.script>
			</properties>
		</profile>
		<profile>
			<id>jlink-unix</id>
			<activation>
				<os>
					<family>unix</family>
				</os>
			</activation>
			<properties>
				<jlink.script>${basedir}/scripts/jlink-build.sh</jlink.script>
				<verify.script>${basedir}/scripts/verify-tools.sh</verify.script>
			</properties>
		</profile>
	</profiles>
</project>