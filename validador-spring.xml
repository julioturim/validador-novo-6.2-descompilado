<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
	xmlns:context="http://www.springframework.org/schema/context"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
         http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
         http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-3.0.xsd"
	default-lazy-init="true">

	<context:component-scan base-package="br.mp.mpf, DAO, negocio, telas" />

	<bean id="connectionProvider" class="br.mp.mpf.pgr.client.jdbc.JdbcConnectionProvider"></bean>
	
	<bean id="configurador" class="br.mp.mpf.spea.simba.validador.ConfiguradorValidador"></bean>

	<bean id="controlador" class="br.mp.mpf.spea.simba.validador.ControladorValidador"></bean>

	<bean id="bancoHSQLDB" class="DAO.BancoHSQLDB" scope="prototype"></bean>

	<bean id="frmSelecionaDiretorio" class="telas.frmSelecionaDiretorio" scope="prototype"></bean>
	
	<bean id="frmSelecionaDiretorioGab" class="telas.frmSelecionaDiretorioGab" scope="prototype"></bean>
	
	<bean id="frmDadosAtendimento" class="telas.frmDadosAtendimento" scope="prototype"></bean>
	
	<bean id="criarTabelasCmd" class="br.mp.mpf.spea.simba.validador.CriarTabelasValidador" scope="prototype"></bean>
	
	<bean id="frmTrataEnvio" class="telas.frmTrataEnvio" scope="prototype"></bean>

</beans>